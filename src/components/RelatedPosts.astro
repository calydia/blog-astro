---
import { Image } from 'astro:assets';
import dayjs from 'dayjs';
import type BlogData from '../interfaces/blogHighlight';

const { posts } = Astro.props as { posts: BlogData[] };
---

{posts.length > 0 && (
  <section aria-labelledby="related-posts-heading" class="mt-12 border-t-4 border-solid border-lt-blue-dark dark:border-dk-blue-light">
    <h2 id="related-posts-heading" class="text-2xl lg:text-3xl font-bold mb-6">
      Related posts
    </h2>
    <ul class="grid grid-cols-1 gap-6 md:grid-cols-3 p-0 m-0" role="list">
      {posts.map((post) => (
        <li class="related-post-card card-cover relative">
          <Image
            src={post.listingImage}
            alt=""
            width={690}
            height={404}
          />
          <div class="py-3">
            <a href={`/${post.category.toLowerCase()}${post.slug}`}
              class="card-cover__link post-link no-underline"
            >
              <span class="post-title block font-semibold text-lg leading-snug">
                {post.title}
              </span>
            </a>
            <span class="related-post-date block text-base mt-1 text-lt-gray dark:text-dk-gray">
              {dayjs(post.date).format('MMMM DD, YYYY')}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </section>
)}

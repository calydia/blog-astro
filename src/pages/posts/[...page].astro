---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import PostGrid from '../../components/PostGrid.astro';
import type BlogData from '../../interfaces/blogHighlight';
import { fetchAllArticles } from '../../utils/blogApi';
import { POSTS_PER_PAGE } from '../../utils/pagination';

export const getStaticPaths = (async ({ paginate }) => {
  const response = await fetchAllArticles({ fieldSet: 'listing' });
  return paginate(response.articles.items as BlogData[], { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const currentPage = page.currentPage;
const title = currentPage === 1 ? 'All posts' : `All posts – Page ${currentPage}`;
const metaDescription = currentPage === 1
  ? 'Browse all posts about accessibility, technology, life, cats, and games.'
  : `Browse page ${currentPage} of posts about accessibility, technology, life, cats, and games.`;
const currentUrl = currentPage === 1 ? '/posts' : `/posts/${currentPage}`;
const getPageUrl = (pageNumber: number) => pageNumber === 1 ? '/posts/' : `/posts/${pageNumber}/`;
---

<Layout title={title} metaDescription={metaDescription} currentUrl={currentUrl}>
  <div class="max-w-[1564px] mx-auto md:px-8-px">
    <div class="text-lt-gray dark:text-dk-gray pt-4 pb-2 px-4-px max-w-xl mx-auto md:pt-8 md:pb-4 md:px-8-px lg:max-w-4xl">
      <h1 id="skip-target" class="block px-4-px font-bold text-center mt-6 lg:mt-10 mb-3 lg:mb-5 text-4xl md:text-5xl text-lt-gray-heading dark:text-dk-gray-heading">{title}</h1>
      {currentPage === 1 && <p class="my-0 text-lg md:text-xl text-center">Writing about accessibility, technology, life, cats, and games.</p>}
    </div>
  </div>

  <section class="max-w-7xl mx-4-px mb-8 md:mb-12 xl:mx-auto" slot="blogs" aria-label="All blog posts">
    <PostGrid posts={page.data as BlogData[]} />
    <Pagination currentPage={currentPage} totalPages={page.lastPage} getPageUrl={getPageUrl} />
  </section>
</Layout>

---
import CategoryArchivePage from '../components/CategoryArchivePage.astro';
import type BlogData from '../interfaces/blogHighlight';
import { fetchAllArticles, fetchPageContent } from '../utils/blogApi';
import { getCategoryDiscoveryConfig } from '../utils/categoryDiscovery';

const category = getCategoryDiscoveryConfig('cats')!;
const [frontContent, allPostsResponse] = await Promise.all([
  fetchPageContent(category.pageId),
  fetchAllArticles({ category: category.drupalCategoryId, fieldSet: 'listing' }),
]);
const allPosts = allPostsResponse.articles.items as BlogData[];
---

<CategoryArchivePage category={category} frontContent={frontContent} allPosts={allPosts} />
